{
  "model": "gpt-4o",
  "maxSteps": 50,
  "retrospectTimeoutMinutes": 10,
  "defaultTimeRange": "ago(1h)",
  "maxConcurrentInvestigations": 3,
  "maxConcurrentScheduledInvestigations": 2,
  "scheduledInvestigationMaxSteps": 20,
  "scheduledInvestigationRetentionCount": 10,
  "autoRefreshInterval": 30,
  "notifications": true,
  "defaultView": "grid",
  "defaultSortOrder": "newest",
  "defaultPageSize": 12,
  "llmProvider": {
    "type": "openai",
    "apiKey": "sk-..."
  },
  "incidentProvider": {
    "type": "manual"
  },
  "mcpServers": [
    {
      "name": "my-data-server",
      "command": "npx",
      "args": ["-y", "my-mcp-server"],
      "env": {}
    }
  ],
  "products": [
    {
      "id": "my-product",
      "name": "My Product",
      "repoRoot": "/path/to/MyProduct",
      "systemPromptPath": ".github/agents/MyProduct_Investigation.agent.md",
      "knowledgeBasePath": "docs/investigations",
      "workingDirectory": ".",
      "investigationsPath": "investigations"
    }
  ],
  "activeProductId": "my-product"
}
