VMApiQosEvent | where TIMESTAMP between (datetime(2026-01-26T05:55:00Z) .. datetime(2026-01-26T10:10:56Z)) | where resourceGroupName contains "kucompute" | where resourceGroupName contains "dewc" | where operationName == "VirtualMachineScaleSets.AutoOSUpgrade.POST" | where oSProvisionDurationInSeconds > 0 and resultType == 0 | parse resourceGroupName with * "kucompute-" ClusterName | summarize PatchCount = count(), AvgDurationSec = avg(oSProvisionDurationInSeconds), MaxDurationSec = max(oSProvisionDurationInSeconds), FirstPatch = min(TIMESTAMP), LastPatch = max(TIMESTAMP) by ClusterName | order by PatchCount desc