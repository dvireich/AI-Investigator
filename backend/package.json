{
    "name": "investigation-dashboard-backend",
    "version": "1.0.0",
    "description": "Backend for the Investigation Dashboard",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "latest",
        "axios": "^1.13.5",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "openai": "^6.22.0",
        "puppeteer": "^24.39.0",
        "ws": "^8.13.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.17",
        "@types/node": "^20.4.5",
        "@types/puppeteer": "^5.4.7",
        "@types/supertest": "^7.2.0",
        "@types/ws": "^8.5.5",
        "@vitest/coverage-v8": "^3.2.4",
        "supertest": "^7.2.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.1.6",
        "vitest": "^3.2.4"
    }
}
